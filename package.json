{
  "name": "authenticheck",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@authenticheck/web",
    "build": "npm run build --workspace=@authenticheck/web",
    "start": "npm run start --workspace=@authenticheck/web",
    "dev:api": "npm --prefix apps/api run dev",
    "build:api": "npm --prefix apps/api run build",
    "typecheck": "npm run typecheck --workspace=@authenticheck/web && npm run build:api",
    "lint": "npm run lint --workspace=@authenticheck/web",
    "dev:web": "npm --prefix apps/web run dev"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
