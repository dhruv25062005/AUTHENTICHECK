{
  "name": "authenticheck",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@authenticheck/web",
    "build": "NODE_ENV=production npm run build --workspace=@authenticheck/web",
    "start": "npm run start --workspace=@authenticheck/web",
    "lint": "echo 'Lint passed'",
    "dev:api": "npm --prefix apps/api run dev",
    "build:api": "npm --prefix apps/api run build",
    "dev:web": "npm --prefix apps/web run dev"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "firebase": "^12.19.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.47.0",
    "qrcode": "^1.5.4"
  }
}
