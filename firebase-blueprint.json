{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access control and organizational linkage",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "enum": ["MANUFACTURER", "CONSUMER", "AUDITOR"] },
        "organizationName": { "type": "string", "maxLength": 150 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "email", "role", "createdAt"]
    },
    "IncidentReport": {
      "title": "IncidentReport",
      "description": "Counterfeit incident reports submitted by consumers or inspectors",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "serialNumber": { "type": "string", "maxLength": 64 },
        "productName": { "type": "string", "maxLength": 128 },
        "reportedBy": { "type": "string", "maxLength": 128 },
        "merchantName": { "type": "string", "maxLength": 128 },
        "merchantLocation": { "type": "string", "maxLength": 128 },
        "storeLocation": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "maxLength": 1000 },
        "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "CRITICAL"] },
        "status": { "type": "string", "enum": ["PENDING", "INVESTIGATING", "RESOLVED"] },
        "evidenceUrl": { "type": "string", "maxLength": 1000000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "serialNumber", "reason", "severity", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User account document stored under their authenticated uid"
    },
    "/incidentReports/{reportId}": {
      "schema": { "$ref": "#/entities/IncidentReport" },
      "description": "Counterfeit reports and chargeback dispute documentation"
    }
  }
}
